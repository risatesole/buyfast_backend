PLATFORM_NAME="blanco"
DB_NAME=postgres
DB_USER=#############################
DB_PASSWORD=#############
DB_HOST=##########################
DB_PORT=6543
CSRF_TRUSTED_ORIGINS=#######################################################
FRONTEND_URL=http://localhost:3000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,subdomain.example.com
MEDIA_ROOT=/data/media
DJANGO_ENVIRONMENT=development
STATIC_URL="djangostaticfiles.example.com"

DJANGO_DBMS=sqlite3 # or postgress
SUPABASE_PROJECT_ID =####################
SUPABASE_SECRET_KEY==########################################-=####################
SUPABASE_BUCKET=########################

# Leave EMAIL_BACKEND unset to keep printing emails to the console.
# Set it to send real email through SMTP instead. EMAIL_HOST defaults to
# Gmail (smtp.gmail.com) if unset — override it for another provider.
#
# Outlook/Hotmail personal account (smtp-mail.outlook.com):
# requires an app password from account.live.com (basic auth is disabled).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-mail.outlook.com
EMAIL_HOST_USER=youraddress@outlook.com
EMAIL_HOST_PASSWORD=#### Outlook App Password, no spaces ####
DEFAULT_FROM_EMAIL=Economato UASD <youraddress@outlook.com>

# PayPal Sandbox REST app credentials (developer.paypal.com/dashboard -> Sandbox -> Apps).
# PAYPAL_API_BASE defaults to the sandbox host if unset.
PAYPAL_CLIENT_ID=####################################
PAYPAL_CLIENT_SECRET=####################################
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
